+++ b/noteslib.py
@@ -106,3 +106,28 @@ def delete_note(root: str | None, note_id: int) -> bool:
     del meta["notes"][str(note_id)]
     _save_meta(root, meta)
     return True
+
+
+def search_notes(root: str | None, needle: str) -> list[str]:
+    """Case-insensitive substring search across all note bodies.
+
+    Scans every ``.md`` file in the notes home line by line and returns
+    ``RELATIVE_PATH:LINE_NO: TEXT`` strings (1-based line numbers,
+    stripped source lines) ordered by path, then line number.
+    """
+    h = home(root)
+    hits: list[str] = []
+    try:
+        entries = sorted(e for e in os.listdir(h) if e.endswith(".md"))
+    except FileNotFoundError:
+        return hits
+    lowered = needle.lower()
+    for fname in entries:
+        path = os.path.join(h, fname)
+        if not os.path.isfile(path):
+            continue
+        with open(path, encoding="utf-8") as fh:
+            for lineno, line in enumerate(fh, start=1):
+                if lowered in line.lower():
+                    hits.append(f"{fname}:{lineno}: {line.strip()}")
+    return hits
