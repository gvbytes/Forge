+/**
+ * Shared pagination helper used by every list route.
+ *
+ * Windowing semantics (identical to the previously copy-pasted inline
+ * logic): start = (page - 1) * size, then slice `size` rows off the
+ * backing collection. Defaults: page = 1, size = 20.
+ */
+export function paginate<T>(items: readonly T[], page: number = 1, size: number = 20): T[] {
+  const start = (page - 1) * size;
+  return items.slice(start, start + size);
+}
