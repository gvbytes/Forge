{
  "name": "agent-ide",
  "private": true,
  "workspaces": [
    "router",
    "engine",
    "web"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "setup": "bun run scripts/setup-keys.ts",
    "preflight": "bun run scripts/preflight-models.ts",
